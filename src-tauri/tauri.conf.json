{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pepper",
  "version": "0.1.0",
  "identifier": "com.project.sorter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pepper",
        "width": 1024,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["Z:/The Huddle/Production/**/*"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["adobe+4694cbd42914a67015f420c3d5241c8540f26611"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI3QjUyMDJENEExQ0QyQTgKUldTbzBoeEtMU0MxSi9WRkF2eGM5eXZpYUh1dS9RL01rTkd0SmtteGVwU1Y3bDdReTRWbExIVXQK",
      "endpoints": [
        "https://github.com/ChickenAlexanderPillow/project-sorter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
